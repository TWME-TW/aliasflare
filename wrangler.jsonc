{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "aliasflare",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["nodejs_compat"],
	// The app icons and manifest (installing the dashboard as an app). Cloudflare serves these
	// files itself, without running the Worker.
	"assets": { "directory": "public" },
	// Query strings (searches, addresses in notices) are left out of logs and traces.
	"observability": { "enabled": true, "redact_query_string": true },
	// Alias domains and the optional Mailflare connection are set up on the dashboard after
	// you register a passkey. Variables or secrets with the names listed in src/env.d.ts
	// override them; keep_vars leaves dashboard-set ones alone.
	"keep_vars": true,
	// Daily cleanup of old activity (see src/cleanup.ts).
	"triggers": { "crons": ["23 3 * * *"] },
	"send_email": [{ "name": "EMAIL", "remote": true }],
	// Optional: reach Mailflare through a service binding instead of the public internet,
	// when both Workers are on the same account.
	// "services": [{ "binding": "MAILFLARE_SERVICE", "service": "mailflare" }],
	"ratelimits": [
		{ "name": "LOGIN_RATE_LIMIT", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
		{ "name": "API_RATE_LIMIT", "namespace_id": "4102", "simple": { "limit": 300, "period": 60 } }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "aliasflare",
			"migrations_dir": "migrations"
		}
	]
}
